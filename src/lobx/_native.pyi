# (maker_id, taker_id, taker_side, price, qty, ts); taker_side is 0 for buy and 1 for sell.
FillTuple = tuple[int, int, int, int, int, int]
# (id, agent, side, type, price, qty, ts)
OrderTuple = tuple[int, int, int, int, int | None, int, int]
# (seq_id, type, order_id, agent_id, price, qty, ts, success)
EventTuple = tuple[int, int, int, int, int, int, int, bool]

class NativeBook:
    def __init__(self) -> None: ...
    def submit(
        self,
        id: int,
        agent: int,
        side: int,
        type: int,
        price: int | None,
        qty: int,
        ts: int,
    ) -> list[FillTuple]: ...
    def submit_many(self, orders: list[OrderTuple]) -> list[FillTuple]: ...
    def cancel(self, order_id: int, ts: int) -> bool: ...
    def snapshot(self, depth: int) -> tuple[int, list[tuple[int, int]], list[tuple[int, int]]]: ...
    def best_bid(self) -> int | None: ...
    def best_ask(self) -> int | None: ...
    def resting_orders(self) -> int: ...

